# Required for AI scope detection and objective drafting
GROQ_API_KEY=gsk_...

# Optional — higher GitHub rate limit for public month reports
GITHUB_TOKEN=

# GitHub OAuth — client ID enables Device Flow (same as desktop).
# Optional CLIENT_SECRET enables browser redirect instead of a device code.
# Register callback http://localhost:5175/api/auth/github/callback only if using the secret.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:5175/api/auth/github/callback
APP_ORIGIN=http://localhost:5175

# Supabase — Hono API uses the service role (never expose this key to the browser).
# Run every file in supabase/migrations/ (in order) in the SQL editor first.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Encrypts each signed-in user's GitHub token (AES-256-GCM) so the web app can
# read their private/org repo activity, same as the desktop app. Without this,
# sign-in still works but Reports only shows public GitHub activity.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Cloudinary — report files and evidence packs. Supabase only stores the URL/metadata.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or one URL instead of the three values above:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Polar — Paid checkout ($14/mo). Create an org at polar.sh (Guyana payouts are supported).
# Organization access token with checkouts, products, customers, and customer sessions.
POLAR_ACCESS_TOKEN=
# Optional sandbox: POLAR_SERVER=sandbox
# Optional — copy from Products if auto-create is not used:
# POLAR_PRODUCT_ID=
# Webhook signing secret from Polar → Settings → Webhooks → https://YOUR_DOMAIN/api/polar/webhook
# Subscribe to checkout.updated, subscription.*, and order.*
POLAR_WEBHOOK_SECRET=

# Optional — Vantage also emails receipts when a payment is stored.
# Polar emails the customer as merchant of record when checkout has their address.
RESEND_API_KEY=
MAIL_FROM=hello@taekonda.com

PORT=8787
GROQ_MODEL=openai/gpt-oss-20b
